config_version=5

[application]

config/name="Superhero Showdown: City Sandbox"
config/description="Open-world 3D superhero city sandbox and fighting game"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

